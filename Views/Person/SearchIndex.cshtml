@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PhoneBookApplication.ApplicationServices.DTOs.GetAllPersonDto

@{
    ViewData["Title"] = "Contacts";
}

<h1>Contacts</h1>

@if (Model != null && Model.GetByIdPersonDto.Any())
{

    <section class="search-bar">
        <form method="get" asp-action="SearchIndex">
            <input type="text" name="term" placeholder="search here">
            <button class="btn btn-default" type="submit" style="width: 48px; height: 28px; padding: 0; font-size: 16px; border: none; background: #FF0000 ; color: white;"><i></i>search</button>
            <a class="btn btn-default" href="/Person/SearchIndex" style="background: #007bff; color: white;">All</a>
        </form>
    </section>


    <table class="table table-striped">
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Phone Number</th>
                <th>BirthDay</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.GetByIdPersonDto)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                    <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                    <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                    <td>@Html.DisplayFor(modelItem => item.BirthDate)</td>

                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        <h4>No contacts found</h4>
        <p>
            <a asp-action="SearchIndex" class="btn btn-primary btn-lg">Search Contacts</a>
        </p>
    </div>
}