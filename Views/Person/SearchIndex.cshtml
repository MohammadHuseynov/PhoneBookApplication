@using Microsoft.AspNetCore.Mvc.TagHelpers
@model PhoneBookApplication.ViewModels.SearchPersonViewModel

@{
    ViewData["Title"] = "Contacts";
}

<h1>Contacts</h1>

@if (Model != null && Model.GetAllPersonVM.GetByIdPersonDto.Any())
{
    @using (Html.BeginForm())
    {
        <p>
            @Html.TextBox("term")
            <input type="submit" name="term" value="@Model.Term" placeholder="search here">
        </p>
    }

    <section class="search-bar">
        <form method="get" asp-action="SearchIndex">
            <input type="text" name="term" placeholder="search here">
            <button type="submit"><i class="fa fa-search"></i></button>
            <a class="btn btn-default" href="/Person/SearchIndex">All</a>
        </form>
    </section>


    <table class="table table-striped">
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Phone Number</th>
                <th>BirthDay</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.GetAllPersonVM.GetByIdPersonDto)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                    <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                    <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                    <td>@Html.DisplayFor(modelItem => item.BirthDate)</td>

                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        <h4>No contacts found</h4>
        <p>Start by <a asp-action="Create">creating your first Contact</a>.</p>
    </div>
}